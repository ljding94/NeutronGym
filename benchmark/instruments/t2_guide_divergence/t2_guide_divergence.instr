DEFINE INSTRUMENT t2_guide_divergence (
w_in = 0.02, // m] guide entry width/height
w_out = 0.02, // m] guide exit width/height
m_coat = 2.0 // 1] supermirror m-value
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated t2_guide_divergence
%}

TRACE 
COMPONENT src = Source_simple(
 yheight = 0.1, xwidth = 0.1,
 dist = 1.5, focus_xw = w_in,
 focus_yh = w_in, lambda0 = 5,
 dlambda = 0.5)
AT (0, 0, 0) ABSOLUTE

COMPONENT guide = Guide(
 w1 = w_in, h1 = w_in,
 w2 = w_out, h2 = w_out,
 l = 10, m = m_coat)
AT (0, 0, 1.5) RELATIVE src

COMPONENT divmon = Divergence_monitor(
 filename = "div.dat", xwidth = 0.02,
 yheight = 0.02, maxdiv_h = 0.5,
 maxdiv_v = 0.5, restore_neutron = 1)
AT (0, 0, 10.05) RELATIVE guide

COMPONENT psd = PSD_monitor(
 nx = 60, ny = 60,
 filename = "psd.dat", xwidth = 0.03,
 yheight = 0.03, restore_neutron = 1)
AT (0, 0, 10.06) RELATIVE guide

FINALLY 
%{
// Start of finally for generated t2_guide_divergence
%}

END
