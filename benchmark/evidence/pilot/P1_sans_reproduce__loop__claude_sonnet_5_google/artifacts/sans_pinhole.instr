DEFINE INSTRUMENT sans_pinhole (
lambda0 = 6.0, // AA] mean wavelength
dlambda = 0.05 // AA] half-width wavelength spread
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated sans_pinhole
%}

TRACE 
COMPONENT src = Source_gen(
 radius = 0.02, dist = 3.0,
 focus_xw = 0.01, focus_yh = 0.01,
 lambda0 = lambda0, dlambda = dlambda,
 I1 = 100000000.0, verbose = 1)
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT pinhole1 = Slit(
 radius = 0.005)
AT (0.0, 0.0, 3.0) RELATIVE src

COMPONENT pinhole2 = Slit(
 radius = 0.005)
AT (0.0, 0.0, 6.0) RELATIVE src

COMPONENT div_mon_pre = PSD_monitor(
 nx = 100, ny = 100,
 filename = "psd_pre_sample.dat", xwidth = 0.02,
 yheight = 0.02, restore_neutron = 1)
AT (0.0, 0.0, 0.01) RELATIVE pinhole2

COMPONENT sample = Sans_spheres(
 R = 100.0, Phi = 0.001,
 Delta_rho = 0.6, sigma_abs = 0.5,
 xwidth = 0.01, yheight = 0.01,
 zdepth = 0.005, target_x = 0.0,
 target_y = 0.0, target_z = 3.0,
 focus_r = 0.3)
AT (0.0, 0.0, 0.2) RELATIVE pinhole2

COMPONENT beamstop = Beamstop(
 radius = 0.02)
AT (0.0, 0.0, 2.9) RELATIVE sample

COMPONENT detector = PSD_monitor(
 nx = 128, ny = 128,
 filename = "detector.dat", xwidth = 0.6,
 yheight = 0.6, restore_neutron = 1)
AT (0.0, 0.0, 3.0) RELATIVE sample

COMPONENT lambda_mon = L_monitor(
 nL = 100, filename = "lambda_mon.dat",
 xwidth = 0.6, yheight = 0.6,
 Lmin = 5.5, Lmax = 6.5,
 restore_neutron = 1)
AT (0.0, 0.0, 0.001) RELATIVE detector

FINALLY 
%{
// Start of finally for generated sans_pinhole
%}

END
