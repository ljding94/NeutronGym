DEFINE INSTRUMENT templateSANS_rebuild (
lambda = 6.0, // AA] Mean wavelength of neutrons
dlambda = 0.05, // AA] Wavelength spread of neutrons
r = 100.0, // AA] Radius of scattering hard spheres
PHI = 0.001, // 1] Particle volume fraction
Delta_Rho = 0.6, // fm/AA^3] Excess scattering length density
sigma_abs = 0.5 // barns] Absorption cross section at 2200 m/s
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated templateSANS_rebuild
%}

TRACE 
COMPONENT a1 = Progress_bar()
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT arm = Arm()
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT source = Source_simple(
 radius = 0.02, dist = 3,
 focus_xw = 0.01, focus_yh = 0.01,
 lambda0 = lambda, dlambda = dlambda,
 flux = 100000000)
AT (0.0, 0.0, 0.0) RELATIVE arm

COMPONENT coll1 = Slit(
 radius = 0.005)
AT (0.0, 0.0, 3.0) RELATIVE arm

COMPONENT coll2 = Slit(
 radius = 0.005)
AT (0.0, 0.0, 6.0) RELATIVE arm

SPLIT 10 COMPONENT sample = Sans_spheres(
 R = r, Phi = PHI,
 Delta_rho = Delta_Rho, sigma_abs = sigma_abs,
 xwidth = 0.01, yheight = 0.01,
 zdepth = 0.005, target_index = 2,
 focus_xw = 0.6, focus_yh = 0.6)
AT (0.0, 0.0, 0.2) RELATIVE coll2

COMPONENT STOP = Beamstop(
 radius = 0.02)
AT (0.0, 0.0, 2.9) RELATIVE sample

COMPONENT detector = PSD_monitor(
 nx = 128, ny = 128,
 filename = "PSD.dat", xmin = -0.3,
 xmax = 0.3, ymin = -0.3,
 ymax = 0.3)
AT (0.0, 0.0, 3.0) RELATIVE sample

COMPONENT Ldetector = L_monitor(
 nL = 1000, filename = "Edet.dat",
 xmin = -0.3, xmax = 0.3,
 ymin = -0.3, ymax = 0.3,
 Lmin = 5.5, Lmax = 6.5)
AT (0.0, 0.0, 3.01) RELATIVE sample

COMPONENT PSDrad = PSD_monitor_rad(
 filename = "psd2.dat", filename_av = "psd2_av.dat",
 rmax = 0.3)
AT (0.0, 0.0, 3.02) RELATIVE sample

FINALLY 
%{
// Start of finally for generated templateSANS_rebuild
%}

END
