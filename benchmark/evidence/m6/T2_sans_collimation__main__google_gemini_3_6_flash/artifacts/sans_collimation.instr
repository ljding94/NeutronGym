DEFINE INSTRUMENT sans_collimation (
r_pin1 = 0.005, // m
r_pin2 = 0.005 // m
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated sans_collimation
%}

TRACE 
COMPONENT origin = Arm()
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT source = Source_simple(
 radius = 0.02, dist = 3,
 focus_xw = 0.1, focus_yh = 0.1,
 lambda0 = 6, dlambda = 0.05)
AT (0.0, 0.0, 0.0) RELATIVE origin

COMPONENT pinhole1 = Slit(
 radius = r_pin1)
AT (0.0, 0.0, 3.0) RELATIVE origin

COMPONENT pinhole2 = Slit(
 radius = r_pin2)
AT (0.0, 0.0, 6.0) RELATIVE origin

COMPONENT sample = Sans_spheres(
 R = 100, Phi = 0.001,
 Delta_rho = 0.6, zdepth = 0.002,
 radius = 0.015, target_z = 3,
 focus_r = 0.3)
AT (0.0, 0.0, 6.001) RELATIVE origin

COMPONENT beamstop = Beamstop(
 radius = 0.04)
AT (0.0, 0.0, 8.999) RELATIVE origin

COMPONENT detector = PSD_monitor(
 nx = 128, ny = 128,
 filename = "detector.dat", xwidth = 0.6,
 yheight = 0.6)
AT (0.0, 0.0, 9.0) RELATIVE origin

COMPONENT mon_arm = Arm()
AT (0.0, 0.0, 0.0) RELATIVE origin

COMPONENT mon1 = PSD_monitor(
 filename = "mon1.dat", xwidth = 0.1,
 yheight = 0.1, restore_neutron = 1)
AT (0.0, 0.0, 1.0) RELATIVE origin

FINALLY 
%{
// Start of finally for generated sans_collimation
%}

END
