DEFINE INSTRUMENT t2_guide_divergence (
w_in = 0.012, // m] Width of the guide at the entrance
w_out = 0.012, // m] Width of the guide at the exit
m_coat = 1.5 // 1] m-value of the supermirror coating
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated t2_guide_divergence
%}

TRACE 
COMPONENT source = Source_div(
 xwidth = 0.1, yheight = 0.1,
 focus_aw = 0.5, focus_ah = 0.5,
 lambda0 = 5.0, flux = 1.0)
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT guide = Guide_gravity(
 w1 = w_in, h1 = 0.012,
 w2 = w_out, h2 = 0.012,
 l = 10, m = m_coat)
AT (0.0, 0.0, 10.0) ABSOLUTE

COMPONENT sample = Shape(
 xwidth = 0.02, yheight = 0.02)
AT (0.0, 0.0, 15.0) ABSOLUTE

COMPONENT divmon = Divergence_monitor(
 xwidth = 0.02, yheight = 0.02,
 restore_neutron = 1)
AT (0.0, 0.0, 15.0) ABSOLUTE

FINALLY 
%{
// Start of finally for generated t2_guide_divergence
%}

END
