DEFINE INSTRUMENT guide_optimization (
w_in = 0.012, // m] Guide entrance width
w_out = 0.012, // m] Guide exit width
m_coat = 1.5 // dimensionless] Guide coating m-value
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated guide_optimization
%}

TRACE 
COMPONENT source = Source_simple(
 yheight = 0.1, xwidth = 0.1,
 dist = 1.5, focus_xw = 0.012,
 focus_yh = 0.012, lambda0 = 5.0,
 dlambda = 0.5)
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT guide = Guide_gravity(
 w1 = w_in, h1 = w_in,
 l = 10.0, m = m_coat,
 G = 9.81)
AT (0.0, 0.0, 1.5) RELATIVE source

COMPONENT divmon = Divergence_monitor(
 nh = 100, nv = 100,
 xwidth = w_out, yheight = w_out,
 maxdiv_h = 0.5, maxdiv_v = 0.5,
 restore_neutron = 1)
AT (0.0, 0.0, 0.05) RELATIVE guide

FINALLY 
%{
// Start of finally for generated guide_optimization
%}

END
