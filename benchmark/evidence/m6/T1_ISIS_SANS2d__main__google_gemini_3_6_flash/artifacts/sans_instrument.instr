DEFINE INSTRUMENT sans_instrument (
L1 = 3.926, // m] Collimation length / sample distance
A1w = 0.03, // m] Aperture 1 width
A1h = 0.02, // m] Aperture 1 height
S6 = 0.006, // m] S6 slit radius
A2 = 0.006, // m] Aperture 2 radius
Lmin = 1.0, // AA] Min wavelength
Lmax = 14.0 // AA] Max wavelength
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated sans_instrument
%}

TRACE 
COMPONENT Origin = Arm()
