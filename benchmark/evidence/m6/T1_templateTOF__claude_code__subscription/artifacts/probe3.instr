DEFINE INSTRUMENT probe3 (
string environment = "Al.laz" 
)

DECLARE 
%{
double _dt0 = 6.4e-06;
%}

INITIALIZE 
%{
// Start of initialize for generated probe3
%}

TRACE 
COMPONENT samp = Isotropic_Sqw(
 Sqw_coh = environment, radius = 0.025,
 thickness = 0.002, yheight = 0.1,
 verbose = 0, concentric = 1)
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT mon = Monitor_nD(
 xwidth = 2.5, yheight = 0.4,
 options = "energy limits=[2.47 9.88] bins=50, theta limits=[5 175] bins=150, banana, parallel")
AT (0.0, 0.0, 0.0) ABSOLUTE

FINALLY 
%{
// Start of finally for generated probe3
%}

END
