COMPONENT NL1B_Elliptical_Entrance_Window = Arm()
AT (0.0, 0.0, 3.5) RELATIVE NL1B_Straight2_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Straight2_Entrance_Window

COMPONENT elliptical_piece = Guide_tapering(
