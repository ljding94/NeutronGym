 xwidth = 0.08, yheight = 0.08,
 Emin = e_min, Emax = e_max,
 restore_neutron = 1)
AT (0.0, 0.0, L2-0.1) RELATIVE Mono_sample_arm
ROTATED (0.0, 0.0, 0.0) RELATIVE Mono_sample_arm

COMPONENT Sample_center = Arm()
AT (0.0, 0.0, L2) RELATIVE Mono_sample_arm
ROTATED (0.0, A3, 0.0) RELATIVE Mono_sample_arm

COMPONENT Sample_analyser_arm = Arm()
AT (0.0, 0.0, 0.0) RELATIVE Sample_center
ROTATED (0.0, A4, 0.0) RELATIVE Sample_center

COMPONENT div_mono = Divergence_monitor(
