double beta_guide_1 = 0.3817;
double beta_guide_2 = 0.3641;
double s_guide_1 = 0.0622;
double s_guide_2 = 0.0566;
%}

INITIALIZE 
%{
// Start of initialize for generated tas_rebuild_v2
%}

TRACE 
COMPONENT Origin = Progress_bar()
AT (0.0, 0.0, 0.0) ABSOLUTE
