double L1 = 1.75;
double L2 = 2.2;
double DM = 3.355;
double DA = 3.355;
double A1 = -37.16;
double A2 = -74.32;
double RMH = -3.27;
double RMV = -2.385;
double SelFreq = 213.6;
double l_min = 3.956;
double l_max = 4.152;
