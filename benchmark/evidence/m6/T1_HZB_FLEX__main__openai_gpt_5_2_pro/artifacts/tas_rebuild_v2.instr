DEFINE INSTRUMENT tas_rebuild_v2 (
kI = 1.55, // AA^-1] Incident wavevector
kF = 1.55, // AA^-1] Final wavevector (unused in truncated model)
wVS = 0.03, // m] Virtual source width
tilt = 0.0, // deg] Selector tilt
SA = -1.0, // Analyzer sign (unused here)
A3 = 0.0, // deg] Sample angle A3
A4 = 70.0, // deg] Sample scattering angle A4
L3 = 1.0, // m] Sample-analyzer distance (unused)
L4 = 1.0, // m] Analyzer-detector distance (unused)
Mono_flatswitch = 0.0 // If 1, mono curvature RH=0 (not applied in v2)
)

DECLARE 
%{
double MGUIDE = 3.2;
