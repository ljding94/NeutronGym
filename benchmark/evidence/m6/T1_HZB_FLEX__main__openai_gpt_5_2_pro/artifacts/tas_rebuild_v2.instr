AT (0.0, 0.0, 0.0) RELATIVE NL1A_NL1B_NL2_NL3_InPile_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1A_NL1B_NL2_NL3_InPile_Entrance_Window

COMPONENT NL1B_Straight1_Entrance_Window = Arm()
AT (-0.1277, 0.0, 3.405) RELATIVE Origin
ROTATED (0.0, -2.15, 0.0) RELATIVE Origin

COMPONENT NL1B_Straight1 = Guide(
