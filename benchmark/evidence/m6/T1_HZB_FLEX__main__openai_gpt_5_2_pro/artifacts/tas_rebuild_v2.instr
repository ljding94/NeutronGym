AT (0.0, 0.0, 0.0) RELATIVE Origin
ROTATED (0.0, 0.0, 0.0) RELATIVE Origin

COMPONENT NL1A_NL1B_NL2_NL3_InPile_Entrance_Window = Arm()
AT (0.0, 0.0, 1.53) RELATIVE Origin
ROTATED (0.0, 0.0, 0.0) RELATIVE Origin

COMPONENT NL1A_NL1B_NL2_NL3_InPile = Guide(
