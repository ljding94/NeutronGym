ROTATED (0.0, 0.0, 180.0) RELATIVE NL1B_Curved_Entrance_Window

COMPONENT NL1B_Velocity_Selector_Gap_Entrance_Window = Arm()
AT (-s_guide_1, 0.0, LGUIDE_1) RELATIVE NL1B_Curved_Entrance_Window
