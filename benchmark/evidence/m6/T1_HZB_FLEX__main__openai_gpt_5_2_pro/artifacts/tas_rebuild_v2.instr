 Qcy = 0.0217, alphax = 4.0,
 alphay = alpha_para, W = 0.002,
 mx = 5.2, my = MGUIDE,
 segno = 800)
AT (0.0, 0.0, 0.0) RELATIVE NL1B_Elliptical_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Elliptical_Entrance_Window

COMPONENT Virtual_source = Slit(
 xwidth = wVS, yheight = 0.2)
AT (0.0, 0.0, 2.9) RELATIVE NL1B_Elliptical_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Elliptical_Entrance_Window

COMPONENT NL1B_Vertical_Guide_Entrance_Window = Arm()
AT (0.0, 0.0, 2.925) RELATIVE NL1B_Elliptical_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Elliptical_Entrance_Window

COMPONENT NL1B_Vertical_Guide = Guide_channeled(
 w1 = 0.03, h1 = 0.125,
 w2 = 0.15, h2 = 0.125,
