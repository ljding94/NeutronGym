AT (0.0, 0.0, 0.46) RELATIVE NL1B_Velocity_Selector_Gap_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Velocity_Selector_Gap_Entrance_Window

COMPONENT NL1B_Curved_2_Entrance_Window = Arm()
AT (0.0, 0.0, 0.47) RELATIVE NL1B_Velocity_Selector_Gap_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Velocity_Selector_Gap_Entrance_Window

COMPONENT NL1B_Curved_Guide_2 = Guide_curved(
