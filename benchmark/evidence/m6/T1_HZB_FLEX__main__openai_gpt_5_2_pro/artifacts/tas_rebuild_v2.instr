AT (0.0, 0.0, 0.0) RELATIVE Mono_center
ROTATED (0.0, 0.0, 0.0) RELATIVE Mono_center

COMPONENT Mono_sample_arm = Arm()
AT (0.0, 0.0, 0.0) RELATIVE Mono_center
ROTATED (0.0, A2, 0.0) RELATIVE Mono_center

COMPONENT energy_mono = E_monitor(
 nE = 200, filename = "energy-mono.dat",
 xwidth = 0.2, yheight = 0.125,
 Emin = e_min, Emax = e_max,
 restore_neutron = 1)
AT (0.0, 0.0, 0.15) RELATIVE Mono_sample_arm
ROTATED (0.0, 0.0, 0.0) RELATIVE Mono_sample_arm

COMPONENT energy_pre_sample = E_monitor(
