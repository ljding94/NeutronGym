COMPONENT NL1B_Straight2_Entrance_Window = Arm()
AT (-s_guide_2, 0.0, LGUIDE_2) RELATIVE NL1B_Curved_2_Entrance_Window
ROTATED (0.0, -beta_guide_2, 0.0) RELATIVE NL1B_Curved_2_Entrance_Window

COMPONENT NL1B_Straight2 = Guide(
