AT (0.0, 0.0, 0.0) RELATIVE NL1B_Straight1_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Straight1_Entrance_Window

COMPONENT NL1B_Curved_Entrance_Window = Arm()
AT (0.0, 0.0, 1.549) RELATIVE NL1B_Straight1_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Straight1_Entrance_Window

COMPONENT NL1B_Curved_Guide_1 = Guide_curved(
