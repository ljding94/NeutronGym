 nslit = 1, Qcx = Qc_para,
 Qcy = Qc_para, alphax = alpha_para,
 alphay = alpha_para, W = W_para,
 mx = 0, my = MGUIDE)
AT (0.0, 0.0, 0.0) RELATIVE NL1B_Vertical_Guide_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Vertical_Guide_Entrance_Window

COMPONENT NL1B_Guide_Exit = Arm()
AT (0.0, 0.0, 1.475) RELATIVE NL1B_Vertical_Guide_Entrance_Window
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Vertical_Guide_Entrance_Window

COMPONENT energy_endguide = E_monitor(
