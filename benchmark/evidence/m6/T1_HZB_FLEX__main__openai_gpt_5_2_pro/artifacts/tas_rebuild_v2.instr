 Emin = e_min, Emax = e_max,
 restore_neutron = 1)
AT (0.0, 0.0, 0.0) RELATIVE NL1B_Guide_Exit
ROTATED (0.0, 0.0, 0.0) RELATIVE NL1B_Guide_Exit

COMPONENT Mono_center = Arm()
AT (0.0, 0.0, 0.25) RELATIVE NL1B_Guide_Exit
ROTATED (0.0, A1, 0.0) RELATIVE NL1B_Guide_Exit

COMPONENT Monochromator = Monochromator_curved(
