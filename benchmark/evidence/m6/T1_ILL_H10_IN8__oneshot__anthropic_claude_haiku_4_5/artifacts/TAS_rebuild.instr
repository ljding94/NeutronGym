/*
 * Triple-Axis Spectrometer (TAS) in McStas 3.x
 * Rebuilt from specification with Source_gen, collimators, and diagnostics
 */

DEFINE INSTRUMENT TAS_rebuild(
  KF=5, KI=0, QM=0.5, EN=0, verbose=1,
  WM=0.233, HM=0.197, RMH=-1, RMV=-1, DM=1.807, NHM=15, NVM=15,
  WA=0.16, HA=0.08, RAH=-1, RAV=-1, DA=2.087, NHA=15, NVA=15,
  L1=2.3, ALF1=60, ALF2=60, ALF3=60, ALF4=60,
  BET1=120, BET2=120, BET3=120, BET4=120,
  string Sqw_coh="V.lau"
)

DECLARE %{
  /* Machine state: HKL and real-space parameters */
  struct {
    double ei;      /* incident energy [meV] */
    double ef;      /* final energy [meV] */
    double ki;      /* incident wavevector [Å^-1] */
    double kf;      /* final wavevector [Å^-1] */
    double q;       /* scattering vector [Å^-1] */
    double en;      /* energy transfer [meV] */
    double l1;      /* source-to-monochromator distance [m] */
    double l2;      /* monochromator-to-sample distance [m] */
    double l3;      /* sample-to-analyzer distance [m] */
    double l4;      /* analyzer-to-detector distance [m] */
  } machine_hkl;

  struct {
    double a1, a2, a3, a4;  /* scattering angles [deg] */
    double a5, a6;          /* sample orientation [deg] */
  } machine_real;

  double DEG2RAD = M_PI / 180.0;
  double RAD2DEG = 180.0 / M_PI;
%}

INITIALIZE %{
  /* Compute HKL machine state from input parameters */
  machine_hkl.l1 = L1;
  machine_hkl.l2 = 0.5;  /* default monochromator-to-sample */
  machine_hkl.l3 = 0.5;  /* default sample-to-analyzer */
  machine_hkl.l4 = 0.5;  /* default analyzer-to-detector */

  /* Energy and wavevector from KI, KF, EN */
  if (KI > 0) {
    machine_hkl.ki = KI;
    machine_hkl.ei = 81.81 / (machine_hkl.ki * machine_hkl.ki);
  } else {
    machine_hkl.ei = 14.0;  /* default incident energy [meV] */
    machine_hkl.ki = sqrt(81.81 / machine_hkl.ei);
  }

  if (KF > 0) {
    machine_hkl.kf = KF;
    machine_hkl.ef = 81.81 / (machine_hkl.kf * machine_hkl.kf);
  } else {
    machine_hkl.ef = machine_hkl.ei - EN;
    machine_hkl.kf = sqrt(81.81 / machine_hkl.ef);
  }

  machine_hkl.en = machine_hkl.ei - machine_hkl.ef;
  machine_hkl.q = QM;

  /* Bragg angles from d-spacing and wavelength */
  double lambda_m = 2.0 * M_PI / machine_hkl.ki;  /* monochromator wavelength */
  double lambda_a = 2.0 * M_PI / machine_hkl.kf;  /* analyzer wavelength */
  double theta_m = asin(lambda_m / (2.0 * DM)) * RAD2DEG;
  double theta_a = asin(lambda_a / (2.0 * DA)) * RAD2DEG;

  machine_real.a1 = 2.0 * theta_m;
  machine_real.a3 = 2.0 * theta_a;
  machine_real.a2 = machine_real.a1;  /* default: symmetric scattering */
  machine_real.a4 = machine_real.a3;

  if (verbose) {
    printf("TAS_rebuild: ei=%.3f meV, ef=%.3f meV, en=%.3f meV\n",
           machine_hkl.ei, machine_hkl.ef, machine_hkl.en);
    printf("  ki=%.4f Å^-1, kf=%.4f Å^-1, q=%.4f Å^-1\n",
           machine_hkl.ki, machine_hkl.kf, machine_hkl.q);
    printf("  a1=%.2f°, a3=%.2f°\n", machine_real.a1, machine_real.a3);
  }
%}

TRACE

COMPONENT Origin = Progress_bar(
  profile=1
)
AT [0, 0, 0] ABSOLUTE

COMPONENT Source = Source_gen(
  radius=0.10,
  dist=machine_hkl.l1,
  focus_xw=fabs(WM * sin(machine_real.a1 * DEG2RAD)),
  focus_yh=HM,
  E0=machine_hkl.ei,
  dE=machine_hkl.ei * 0.03,
  I1=0.5874e13,
  T1=683.7,
  T2=257.7,
  I2=2.5099e13,
  T3=16.7,
  I3=1.0343e12
)
AT [0, 0, 0] ABSOLUTE

COMPONENT M1_in = Monitor_nD(
  xwidth=WM * 1.2,
  yheight=HM * 1.2,
  options="x y",
  restore_neutron=1
)
AT [0, 0, machine_hkl.l1 / 8] ABSOLUTE

COMPONENT M1_lambda = Monitor_nD(
  xwidth=WM * 1.2,
  yheight=HM * 1.2,
  options="lambda",
  Lmin=0.5,
  Lmax=10.0,
  restore_neutron=1
)
AT [0, 0, machine_hkl.l1 / 8 + 0.01] ABSOLUTE

COMPONENT SC1 = Collimator_linear(
  xmin=-WM / 2,
  xmax=WM / 2,
  ymin=-HM / 2,
  ymax=HM / 2,
  length=machine_hkl.l1 / 2,
  divergence=ALF1,
  divergenceV=BET1
)
WHEN (ALF1 && BET1)
AT [0, 0, machine_hkl.l1 / 4] ABSOLUTE

COMPONENT M2_out = Monitor_nD(
  xwidth=WM * 1.2,
  yheight=HM * 1.2,
  options="x y",
  restore_neutron=1
)
AT [0, 0, machine_hkl.l1 - 0.25] ABSOLUTE

COMPONENT M2_lambda = Monitor_nD(
  xwidth=WM * 1.2,
  yheight=HM * 1.2,
  options="lambda",
  Lmin=0.5,
  Lmax=10.0,
  restore_neutron=1
)
AT [0, 0, machine_hkl.l1 - 0.24] ABSOLUTE

COMPONENT Guide_out = Arm()
AT [0, 0, machine_hkl.l1 - 0.2] ABSOLUTE

END
