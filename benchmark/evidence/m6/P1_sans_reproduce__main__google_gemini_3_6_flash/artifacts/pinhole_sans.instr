DEFINE INSTRUMENT pinhole_sans (
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated pinhole_sans
%}

TRACE 
COMPONENT progress = Progress_bar()
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT source = Source_gen(
 radius = 0.02, dist = 3,
 focus_xw = 0.01, focus_yh = 0.01,
 I1 = 100000000, Lmin = 5.95,
 Lmax = 6.05)
AT (0.0, 0.0, 0.0) RELATIVE progress

COMPONENT pinhole1 = Slit(
 radius = 0.005)
AT (0.0, 0.0, 3.0) RELATIVE source

COMPONENT pinhole2 = Slit(
 radius = 0.005)
AT (0.0, 0.0, 3.0) RELATIVE pinhole1

COMPONENT mon_before_sample = PSD_monitor(
 nx = 100, ny = 100,
 filename = "beam_sample.dat", xwidth = 0.02,
 yheight = 0.02, restore_neutron = 1)
AT (0.0, 0.0, 1e-05) RELATIVE pinhole2

COMPONENT sample = Sans_spheres(
 R = 100, Phi = 0.001,
 Delta_rho = 0.6, sigma_abs = 0.5,
 xwidth = 0.01, yheight = 0.01,
 zdepth = 0.005, target_z = 3,
 focus_r = 0.3)
AT (0.0, 0.0, 0.2) RELATIVE pinhole2

COMPONENT beamstop = Beamstop(
 radius = 0.02)
AT (0.0, 0.0, 2.9) RELATIVE sample

COMPONENT detector = PSD_monitor(
 nx = 128, ny = 128,
 filename = "sans_detector.dat", xwidth = 0.6,
 yheight = 0.6)
AT (0.0, 0.0, 0.1) RELATIVE beamstop

COMPONENT l_mon = L_monitor(
 nL = 100, filename = "l_mon.dat",
 xwidth = 0.6, yheight = 0.6,
 Lmin = 5.5, Lmax = 6.5)
AT (0.0, 0.0, 1e-05) RELATIVE detector

FINALLY 
%{
// Start of finally for generated pinhole_sans
%}

END
