/*****************************************************************************
* McStas instrument definition
* Title: SESANS Instrument Specification
* Author: Generated by Expert McStas Instrument Scientist
* Date: 2023
* Description: SESANS instrument simulation based on provided specifications.
*****************************************************************************/
DEFINE INSTRUMENT SESANS_spec (
    double L0 = 2.165,
    double DL = 0.02,
    double By = 0.00468
)

DECLARE
%{
%}

INITIALIZE
%{
%}

TRACE

COMPONENT origin = Progress_bar()
  AT [0, 0, 0] RELATIVE ABSOLUTE
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT src = Source_simple(
    yheight = 0.01,
    xwidth = 0.01,
    dist = 2.25,
    focus_xw = 0.01,
    focus_yh = 0.01,
    lambda0 = L0,
    dlambda = DL,
    gauss = 1)
  AT [0, 0, 0] RELATIVE origin
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT set_pol = Set_pol(
    px = 1)
  AT [0, 0, 0.1] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT px1 = PolLambda_monitor(
    nL = 501,
    restore_neutron = 1,
    filename = "pxAfterAnalyser1",
    mx = 1,
    Lmin = L0 - DL,
    Lmax = L0 + DL)
  AT [0, 0, 0.01] RELATIVE set_pol
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT f1 = Foil_flipper_magnet(
    xwidth = 0.1,
    yheight = 0.1,
    zdepth = 0.3,
    phi = 0.095993,
    foilthick = 3.0,
    Bx = 0,
    By = By,
    Bz = 0,
    foil_in = 1,
    verbose = 0)
  AT [0, 0, 0.5] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT px2 = PolLambda_monitor(
    nL = 501,
    restore_neutron = 1,
    filename = "pxAfterAnalyser2",
    mx = 1,
    Lmin = L0 - DL,
    Lmax = L0 + DL)
  AT [0, 0, 0.16] RELATIVE f1
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT f2 = Foil_flipper_magnet(
    xwidth = 0.1,
    yheight = 0.1,
    zdepth = 0.3,
    phi = 0.095993,
    foilthick = 3.0,
    Bx = 0,
    By = By,
    Bz = 0,
    foil_in = 1,
    verbose = 0)
  AT [0, 0, 2.0] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT px3 = PolLambda_monitor(
    nL = 501,
    restore_neutron = 1,
    filename = "pxAfterAnalyser3",
    mx = 1,
    Lmin = L0 - DL,
    Lmax = L0 + DL)
  AT [0, 0, 0.16] RELATIVE f2
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT sans_spheres = SANS_spheres2(
    xwidth = 0.02,
    yheight = 0.02,
    zthick = 0.001,
    dsdw_inc = 0.0,
    sc_aim = 0.8,
    sans_aim = 0.95,
    R = 10000,
    phi = 0.015,
    singlesp = 0,
    Qmind = 0.00003,
    Qmaxd = 0.001)
  WHEN (1==1)
  AT [0, 0, 2.25] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT f3 = Foil_flipper_magnet(
    xwidth = 0.1,
    yheight = 0.1,
    zdepth = 0.3,
    phi = 0.095993,
    foilthick = 3.0,
    Bx = 0,
    By = By,
    Bz = 0,
    foil_in = 1,
    verbose = 0)
  AT [0, 0, 2.5] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT f4 = Foil_flipper_magnet(
    xwidth = 0.1,
    yheight = 0.1,
    zdepth = 0.3,
    phi = 0.095993,
    foilthick = 3.0,
    Bx = 0,
    By = By,
    Bz = 0,
    foil_in = 1,
    verbose = 0)
  AT [0, 0, 4.0] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT px6 = PolLambda_monitor(
    nL = 501,
    restore_neutron = 1,
    filename = "pxAfterAnalyser6",
    mx = 1,
    Lmin = L0 - DL,
    Lmax = L0 + DL)
  AT [0, 0, 0.16] RELATIVE f4
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT ana = PolAnalyser_ideal(
    mx = 1)
  AT [0, 0, 4.4] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT det = PSD_monitor(
    nx = 101,
    ny = 101,
    filename = "det",
    xwidth = 0.011,
    yheight = 0.011)
  AT [0, 0, 4.5] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT trick = Arm()
  AT [0, 0, 4.4] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE
  EXTEND %{
    RESTORE_NEUTRON(INDEX_CURRENT_COMP-2,x,y,z,vx,vy,vz,t,sx,sy,sz,p);
  %}

COMPONENT ana2 = PolAnalyser_ideal(
    mx = -1)
  AT [0, 0, 4.4] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

COMPONENT det2 = PSD_monitor(
    nx = 101,
    ny = 101,
    filename = "det2",
    xwidth = 0.011,
    yheight = 0.011)
  AT [0, 0, 4.5] RELATIVE src
  ROTATED [0, 0, 0] RELATIVE ABSOLUTE

END
