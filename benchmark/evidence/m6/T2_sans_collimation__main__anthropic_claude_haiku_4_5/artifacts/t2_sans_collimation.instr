DEFINE INSTRUMENT t2_sans_collimation (
lambda = 6.0, // Angstrom] Neutron wavelength
dlambda = 0.05, // Angstrom] Wavelength spread (FWHM)
r_pin1 = 0.005, // m] Radius of first pinhole (at 3 m)
r_pin2 = 0.005 // m] Radius of second pinhole (at 6 m)
)

DECLARE 
%{
%}

INITIALIZE 
%{
// Start of initialize for generated t2_sans_collimation
%}

TRACE 
COMPONENT source = Source_simple(
 focus_xw = 0.02, focus_yh = 0.02,
 lambda0 = lambda, dlambda = dlambda,
 flux = 10000000000000.0)
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT pinhole1 = Slit(
 radius = 0.02)
AT (0.0, 0.0, 3.0) ABSOLUTE

COMPONENT pinhole2 = Slit(
 radius = 0.014532473038921006)
AT (0.0, 0.0, 6.0) ABSOLUTE

COMPONENT sample = SANSSpheres(
 R = 100, dR = 0,
 Concentration = 0.01, DeltaRho = 1e-14,
 xwidth = 0.01, yheight = 0.01,
 zdepth = 0.01, SampleToDetectorDistance = 3,
 DetectorRadius = 0.3)
AT (0.0, 0.0, 9.0) ABSOLUTE

COMPONENT beamstop = Beamstop(
 radius = 0.02)
AT (0.0, 0.0, 12.0) ABSOLUTE

COMPONENT detector = PSD_monitor(
 nx = 120, ny = 120,
 filename = "detector", xwidth = 0.6,
 yheight = 0.6, restore_neutron = 0)
AT (0.0, 0.0, 12.0) ABSOLUTE

FINALLY 
%{
// Start of finally for generated t2_sans_collimation
%}

END
