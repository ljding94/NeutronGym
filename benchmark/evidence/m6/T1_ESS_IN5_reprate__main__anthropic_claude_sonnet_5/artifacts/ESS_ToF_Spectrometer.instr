DEFINE INSTRUMENT ESS_ToF_Spectrometer (
Lmin = 4.9, // AA
Lmax = 5.1, // AA
lambda0 = 5, // AA
Pulse_width = 0.002857, // s
Num_pulses = 1, 
GUI_start = 2, // m
FO1_DIST = 6, // m
L_ballistic_begin = 19.5, // m
L_ballistic_end = 17, // m
Length = 100, // m
SAMPLE_DIST = 1.2, // m
DETECTOR_DIST = 4, // m
GUI_h = 0.105, // m
GUI_w = 0.1, // m
GUI_GAP = 0.05, // m
H1 = 0.167, // m
W1 = 0.116, // m
H2 = 0.185, // m
W2 = 0.15, // m
H3 = 0.19, // m
W3 = 0.15, // m
H4 = 0.213, // m
W4 = 0.14, // m
H_chop = 0.075, // m
W_chop = 0.03, // m
H_end = 0.042, // m
W_end = 0.0215, // m
ALPHA = 3.4, 
M = 3.5, 
F_slow1 = 16.6667, // Hz
F_slow2 = 0, // Hz
F_fast1 = 0, // Hz
F_fast2 = 200, // Hz
N_fast = 1, 
SLOW1_THETA = 120, // deg
FO3 = 1, 
THETA_fast1 = 180, // deg
FAST_THETA = 5, // deg
Gamma = 0, 
Etun = 1, 
V_HOLE = 0, 
FRAC_QUASIEL = 0, 
FRAC_TUNNEL = 0, 
TT = 50, // deg
RES_DE = 0.5, // meV
cold = 0.95 
)

DECLARE 
%{
double FREQ;
double t_offset;
double t_FO1;
double t_FO2;
double t_fast1;
double t_fast2;
double t_fast2a;
double t_fast3;
double t_sample;
double t_detector;
double tmin_zoom;
double tmax_zoom;
double E_target;
%}

INITIALIZE 
%{
// Start of initialize for generated ESS_ToF_Spectrometer
%}

TRACE 
COMPONENT source = ESS_butterfly(
 sector = "W", beamline = 5,
 cold_frac = cold, target_index = 6,
 dist = GUI_start, focus_xw = GUI_w,
 focus_yh = GUI_h, Lmin = Lmin,
 Lmax = Lmax, n_pulses = Num_pulses)
AT (0.0, 0.0, -0.1) ABSOLUTE

COMPONENT Origin = Progress_bar()
AT (0.0, 0.0, 0.0) ABSOLUTE
EXTEND %{
FREQ = 14.0;
t_offset = Pulse_width/2.0 + 170e-6;
t_FO1 = FO1_DIST*lambda0/(2*PI*K2V) + t_offset;
t_FO2 = Length/2*lambda0/(2*PI*K2V) + t_offset;
t_fast1 = (Length/2+0.1)*lambda0/(2*PI*K2V) + t_offset;
t_fast2 = Length*lambda0/(2*PI*K2V) + t_offset;
t_fast2a = (Length+GUI_GAP)*lambda0/(2*PI*K2V) + t_offset;
t_fast3 = (Length+2*GUI_GAP)*lambda0/(2*PI*K2V) + t_offset;
t_sample = (Length+SAMPLE_DIST)*lambda0/(2*PI*K2V) + t_offset;
t_detector = (Length+SAMPLE_DIST+DETECTOR_DIST)*lambda0/(2*PI*K2V) + t_offset;
tmin_zoom = t_fast2*1e6 - 1e3;
tmax_zoom = t_fast2*1e6 + 1e3;
E_target = VS2E*(K2V*2*PI/lambda0)*(K2V*2*PI/lambda0);

%}

COMPONENT TOFmoderator_zoom = TOF_monitor(
 nt = 1000, filename = "TOFmoderator_zoom.dat",
 xwidth = 0.12, yheight = 0.12,
 tmin = 0, tmax = 5000,
 restore_neutron = 1)
AT (0.0, 0.0, 1e-06) RELATIVE Origin

COMPONENT TOFmoderator = TOF_monitor(
 nt = 1000, filename = "TOFmoderator.dat",
 xwidth = 0.12, yheight = 0.12,
 tmin = 0, tmax = 300000.0,
 restore_neutron = 1)
AT (0.0, 0.0, 1e-06) RELATIVE Origin

COMPONENT Lmon_guistart = L_monitor(
 nL = 1000, filename = "Lmon_guistart.dat",
 xwidth = GUI_w+0.01, yheight = GUI_h+0.01,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, GUI_start-2e-6) RELATIVE Origin

COMPONENT Lmon_normalize = L_monitor(
 nL = 2880, filename = "Lmon_guistart_normalize.dat",
 xwidth = 0.1, yheight = 0.1,
 Lmin = 0, Lmax = 20)
AT (0.0, 0.0, GUI_start-1e-6) RELATIVE Origin

COMPONENT Guide1 = Guide(
 w1 = GUI_w, h1 = GUI_h,
 w2 = W1, h2 = H1,
 l = FO1_DIST-GUI_start-GUI_GAP/2, R0 = 1,
 alpha = ALPHA, m = M,
 W = 0.003)
AT (0.0, 0.0, GUI_start) RELATIVE Origin

COMPONENT Lmonslow1 = L_monitor(
 nL = 200, filename = "Lmonslow1.dat",
 xwidth = 0.06, yheight = 0.21,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, FO1_DIST-2e-6) RELATIVE Origin

COMPONENT PSDslow1 = PSD_monitor(
 filename = "PSDslow1.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, 0.0, FO1_DIST-1e-6) RELATIVE Origin

COMPONENT FOchop1 = DiskChopper(
 theta_0 = SLOW1_THETA, radius = 0.6,
 yheight = 0.2, nu = F_slow1,
 nslit = 1, delay = t_FO1)
AT (0.0, 0.0, FO1_DIST) RELATIVE Origin

COMPONENT TOFLmon1 = TOFLambda_monitor(
 nL = 200, nt = 200,
 tmin = 0, tmax = 300000,
 filename = "TOFLmon1.dat", xwidth = 0.05,
 yheight = 0.21, Lmin = 0,
 Lmax = Lmax+1)
AT (0.0, 0.0, 1e-06) RELATIVE FOchop1

COMPONENT Lmon_afterslow1 = L_monitor(
 nL = 200, filename = "Lmon_afterslow1.dat",
 xwidth = 0.06, yheight = 0.21,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, 2e-06) RELATIVE FOchop1

COMPONENT PSD_afterslow1 = PSD_monitor(
 filename = "PSD_afterslow1.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, 0.0, 3e-06) RELATIVE FOchop1

COMPONENT Guidelong1 = Guide(
 w1 = W1, h1 = H1,
 w2 = W2, h2 = H2,
 l = L_ballistic_begin+GUI_start-FO1_DIST-GUI_GAP/2, R0 = 1,
 alpha = ALPHA, m = M,
 W = 0.003)
AT (0.0, 0.0, GUI_GAP/2) RELATIVE FOchop1

COMPONENT Guidelong1b = Guide(
 w1 = W2, h1 = H2,
 w2 = W3, h2 = H3,
 l = Length/2-L_ballistic_begin-GUI_start-GUI_GAP/2, R0 = 1,
 alpha = ALPHA, m = M,
 W = 0.003)
AT (0.0, 0.0, L_ballistic_begin+GUI_start) RELATIVE Origin

COMPONENT Lmon_slow2 = L_monitor(
 nL = 200, filename = "Lmon_slow2.dat",
 xwidth = 0.06, yheight = 0.21,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, Length/2-1e-6) RELATIVE Origin

COMPONENT FOchop2 = DiskChopper(
 theta_0 = 155, radius = 0.6,
 yheight = 0.6, nu = F_slow2,
 nslit = 1, delay = t_FO2)
AT (0.0, 0.1, Length/2) RELATIVE Origin

COMPONENT Fastchop1 = DiskChopper(
 theta_0 = THETA_fast1, radius = 0.5,
 yheight = 0.5, nu = F_fast1,
 nslit = N_fast, delay = t_fast1)
AT (0.0, 0.1, Length/2+GUI_GAP) RELATIVE Origin

COMPONENT PSD_afterslow2 = PSD_monitor(
 filename = "PSD_afterslow2.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, -0.1, 1e-06) RELATIVE Fastchop1

COMPONENT Lmon_afterslow2 = L_monitor(
 nL = 200, filename = "Lmon_afterslow2.dat",
 xwidth = 0.06, yheight = 0.21,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, 1e-06) RELATIVE PSD_afterslow2

COMPONENT TOFL_afterslow2 = TOFLambda_monitor(
 nL = 200, nt = 200,
 tmin = 0, tmax = 300000,
 filename = "TOFL_afterslow2.dat", xwidth = 0.05,
 yheight = 0.21, Lmin = 0,
 Lmax = Lmax+1)
AT (0.0, 0.0, 1e-06) RELATIVE Lmon_afterslow2

COMPONENT Guidelong2 = Guide(
 w1 = W3, h1 = H3,
 w2 = W4, h2 = H4,
 l = Length/2-2*GUI_GAP-L_ballistic_end, R0 = 1,
 alpha = ALPHA, m = M,
 W = 0.003)
AT (0.0, -0.1, GUI_GAP/2) RELATIVE Fastchop1

COMPONENT Lmon_beforeballistic = L_monitor(
 nL = 200, filename = "Lmon_before_ballistic.dat",
 xwidth = 0.06, yheight = 0.18,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, Length/2-2*GUI_GAP-L_ballistic_end+1e-6) RELATIVE Guidelong2

COMPONENT PSD_beforeballistic = PSD_monitor(
 filename = "PSD_beforeballistic.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, 0.0, 1e-06) RELATIVE Lmon_beforeballistic

COMPONENT Guidelong2a = Guide(
 w1 = W4, h1 = H4,
 w2 = W_chop, h2 = H_chop,
 l = L_ballistic_end, R0 = 1,
 alpha = ALPHA, m = M,
 W = 0.003)
AT (0.0, 0.0, 1e-06) RELATIVE PSD_beforeballistic

COMPONENT Lmonfast2 = L_monitor(
 nL = 200, filename = "Lmonfast2.dat",
 xwidth = 0.06, yheight = 0.18,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, L_ballistic_end+1e-6) RELATIVE Guidelong2a

COMPONENT Lmonfast2_zoom = L_monitor(
 nL = 200, filename = "Lmonfast2_zoom.dat",
 xwidth = 0.06, yheight = 0.18,
 Lmin = lambda0-0.2, Lmax = lambda0+0.2)
AT (0.0, 0.0, 1e-06) RELATIVE Lmonfast2

COMPONENT TOFLfast2 = TOFLambda_monitor(
 nL = 200, nt = 200,
 tmin = 0, tmax = 300000,
 filename = "TOFLfast2.dat", xwidth = 0.05,
 yheight = 0.12, Lmin = 0,
 Lmax = Lmax+1)
AT (0.0, 0.0, 1e-06) RELATIVE Lmonfast2_zoom

COMPONENT TOFLfast2zoom = TOFLambda_monitor(
 nL = 200, nt = 200,
 tmin = tmin_zoom, tmax = tmax_zoom,
 filename = "TOFLfast2_zoom.dat", xwidth = 0.05,
 yheight = 0.12, Lmin = lambda0-0.2,
 Lmax = lambda0+0.2)
AT (0.0, 0.0, 1e-06) RELATIVE TOFLfast2

COMPONENT PSDfast2 = PSD_monitor(
 filename = "PSDfast2.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, 0.0, 1e-06) RELATIVE TOFLfast2zoom

COMPONENT Fastchop2 = DiskChopper(
 theta_0 = FAST_THETA, radius = 0.35,
 yheight = 0.35, nu = F_fast2,
 nslit = N_fast, delay = t_fast2)
AT (0.0, 0.04, Length) RELATIVE Origin

COMPONENT Fastchop2counter = DiskChopper(
 theta_0 = FAST_THETA, radius = 0.35,
 yheight = 0.35, nu = -F_fast2,
 nslit = N_fast, delay = -t_fast2a)
AT (0.0, 0.04, Length+GUI_GAP) RELATIVE Origin

COMPONENT FOchop3 = DiskChopper(
 theta_0 = 2*FAST_THETA, radius = 0.35,
 yheight = 0.35, nu = F_fast2/FO3,
 nslit = N_fast, delay = t_fast3)
AT (0.0, 0.04, Length+2*GUI_GAP) RELATIVE Origin

COMPONENT TOFfast2_zoom = TOF_monitor(
 nt = 100, filename = "TOF_fast2.dat",
 xwidth = 1.1, yheight = 1.2,
 tmin = 1e6*t_fast3-2e2, tmax = 1e6*t_fast3+2e2)
AT (0.0, -0.04, 1e-06) RELATIVE FOchop3

COMPONENT Lmon_afterfast2 = L_monitor(
 nL = 500, filename = "Lmon_afterfast2.dat",
 xwidth = 0.06, yheight = 0.18,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, 1e-06) RELATIVE TOFfast2_zoom

COMPONENT TOFL_afterfast2 = TOFLambda_monitor(
 nL = 200, nt = 200,
 tmin = 0, tmax = 300000,
 filename = "TOF_afterfast2.dat", xwidth = 0.05,
 yheight = 0.12, Lmin = 0,
 Lmax = Lmax+1)
AT (0.0, 0.0, 1e-06) RELATIVE Lmon_afterfast2

COMPONENT TOFL_afterfast2_zoom = TOFLambda_monitor(
 nL = 200, nt = 200,
 tmin = tmin_zoom, tmax = tmax_zoom,
 filename = "TOFL_afterfast2_zoom.dat", xwidth = 0.05,
 yheight = 0.12, Lmin = lambda0-0.2,
 Lmax = lambda0+0.2)
AT (0.0, 0.0, 1e-06) RELATIVE TOFL_afterfast2

COMPONENT PSD_afterfast2 = PSD_monitor(
 filename = "PSD_afterfast2.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, 0.0, 1e-06) RELATIVE TOFL_afterfast2_zoom

COMPONENT Guidesample = Guide(
 w1 = W_chop, h1 = H_chop,
 w2 = W_end, h2 = H_end,
 l = SAMPLE_DIST-4*GUI_GAP, R0 = 1,
 alpha = ALPHA, m = M,
 W = 0.003)
AT (0.0, 0.0, GUI_GAP/2) RELATIVE PSD_afterfast2

COMPONENT Lmon_guideend = L_monitor(
 nL = 1000, filename = "Lmon_guideend.dat",
 xwidth = W_end+0.01, yheight = H_end+0.01,
 Lmin = 0, Lmax = Lmax+1)
AT (0.0, 0.0, SAMPLE_DIST-4*GUI_GAP+1e-6) RELATIVE Guidesample

COMPONENT PSDsample = PSD_monitor(
 filename = "PSDsample.dat", xwidth = 0.1,
 yheight = 0.25)
AT (0.0, 0.0, SAMPLE_DIST-3*GUI_GAP+1e-6) RELATIVE Lmon_guideend

COMPONENT TOFsample_zoom = TOF_monitor(
 nt = 500, filename = "TOF_sample.dat",
 xwidth = 0.02, yheight = 0.04,
 tmin = 1e6*t_sample-5e4, tmax = 1e6*t_sample+5e4)
AT (0.0, 0.0, 1e-06) RELATIVE PSDsample

COMPONENT Esample = E_monitor(
 nE = 400, filename = "Esample",
 xwidth = 0.02, yheight = 0.04,
 Emin = E_target-RES_DE, Emax = E_target+RES_DE)
AT (0.0, 0.0, 1e-06) RELATIVE TOFsample_zoom

COMPONENT Lmon_sample_zoom = L_monitor(
 nL = 100, filename = "LMON_sample_zoom.dat",
 xwidth = 0.02, yheight = 0.04,
 Lmin = lambda0-0.1, Lmax = lambda0+0.1)
AT (0.0, 0.0, 1e-06) RELATIVE Esample

COMPONENT sample = Tunneling_sample(
 thickness = 0.01-V_HOLE, radius = 0.01,
 p_interact = 1, f_QE = FRAC_QUASIEL,
 f_tun = FRAC_TUNNEL, gamma = Gamma,
 E_tun = Etun, focus_xw = 0.015,
 focus_yh = 0.015, yheight = 0.04,
 target_index = 2)
AT (0.0, -0.04, SAMPLE_DIST) RELATIVE Fastchop2

COMPONENT detectorarm = Arm()
AT (0.0, 0.0, 0.0) RELATIVE sample
ROTATED (0.0, TT, 0.0) RELATIVE sample

COMPONENT TOFdetector = TOF_monitor(
 nt = 512, filename = "TOF.dat",
 xwidth = 0.015, yheight = 0.015,
 tmin = 0, tmax = 200000)
AT (0.0, 0.0, DETECTOR_DIST) RELATIVE detectorarm

COMPONENT TOFdetector_zoom = TOF_monitor(
 nt = 100, filename = "TOF_zoom.dat",
 xwidth = 0.015, yheight = 0.015,
 tmin = 1e6*t_detector-10e2, tmax = 1e6*t_detector+10e2)
AT (0.0, 0.0, 1e-06) RELATIVE TOFdetector

COMPONENT Edetector = E_monitor(
 nE = 400, filename = "Edet",
 xwidth = 0.015, yheight = 0.015,
 Emin = E_target-RES_DE, Emax = E_target+RES_DE)
AT (0.0, 0.0, 1e-06) RELATIVE TOFdetector_zoom

COMPONENT TOF2Edetector = TOF2E_monitor(
 nE = 200, filename = "TOF2E.dat",
 xwidth = 0.015, yheight = 0.015,
 Emin = E_target-RES_DE, Emax = E_target+RES_DE,
 T_zero = t_sample, L_flight = DETECTOR_DIST)
AT (0.0, 0.0, 1e-06) RELATIVE Edetector

FINALLY 
%{
// Start of finally for generated ESS_ToF_Spectrometer
%}

END
