  Qc = mQc,
  alpha = mAlpha,
  m = mGuide1,
  W = mW)
AT (0, 0, gElmtLength1) RELATIVE cg2
ROTATED (0, gElmtRot1, 0) RELATIVE cg2

COMPONENT cg4 = Guide_gravity(
