  alpha = mAlpha,
  m = mGuide1,
  W = mW)
AT (0, 0, gElmtLength1) RELATIVE cg12
ROTATED (0, gElmtRot1, 0) RELATIVE cg12

COMPONENT cg14 = Guide_gravity(
  w1 = gGuideWidth,
  h1 = gGuideHeight1,
  w2 = gGuideWidth,
  h2 = gGuideHeight1,
  l = gElmtLength1 - gElementGap,
  R0 = mR0,
