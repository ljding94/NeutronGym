/*******************************************************************************
*
* McStas, neutron ray-tracing package
*         Copyright (C) 1997-2015, All rights reserved
*         Risø National Laboratory, Roskilde, Denmark
*         Institut Laue-Langevin, Grenoble, France
*
* Instrument: ToF_Spectrometer
*
* %Identification
* Written by: Agent
* Date: 2025
* Origin: <institution>
* %INSTRUMENT_SITE: Generic
*
* %Description
* Time-of-flight spectrometer with triple-bounce monochromator,
* suppressor and Fermi choppers, and inelastic scattering sample.
*
* %Parameters
* lambda: [AA] Neutron wavelength
* dlambda: [AA] Wavelength spread
* SPEED: [rpm] Fermi chopper speed (-1 = auto)
* M1: [steps] Monochromator 1 position (-1 = auto)
* M2: [steps] Monochromator 2 position (-1 = auto)
* M3: [steps] Monochromator 3 position (-1 = auto)
* MONITOR: [1] Enable monitors
* CHA_WIDTH: [us] TOF channel width (-1 = auto)
* TOF_DELAY: [us] TOF delay (-1 = auto)
* TOF_CHA_RESOL: [1] Number of TOF channels
* ELPEAK: [1] Elastic peak channel (-1 = auto)
* RATIO: [1] Suppressor/Fermi speed ratio
* mFC: [1] Fermi chopper m-value for supermirror
* PHASE: [deg] Fermi chopper phase (-360 = auto)
* Sqw_coh: [str] Coherent S(q,w) file
* Sqw_inc: [str] Incoherent S(q,w) file
* radius: [m] Sample radius
* thickness: [m] Sample thickness
*
* %End
*******************************************************************************/

DEFINE INSTRUMENT ToF_Spectrometer(
  double lambda=4.14,
  double dlambda=0.075,
  double SPEED=-1,
  double M1=-1,
  double M2=-1,
  double M3=-1,
  double MONITOR=1,
  double CHA_WIDTH=-1,
  double TOF_DELAY=-1,
  double TOF_CHA_RESOL=128,
  double ELPEAK=-1,
  double RATIO=1,
  double mFC=0,
  double PHASE=-360,
  string Sqw_coh="Rb_liq_coh.sqw",
  string Sqw_inc="Rb_liq_inc.sqw",
  double radius=0.01,
  double thickness=0.005
)

DECLARE
%{
  double DM = 3.355;
  double mos = 40;
  double RV = 3;
  double LME = 2.1;
  double LMM = 0.030;
  double LED = 2.483;
  double LCE = 0.395;
  double LCC = 0.2;
  
  double A1, A2, A3, A2cradle;
  double Ki, vi, Ei;
  double theta;
  double iSPEED, iRATIO, iTOF_CHA_RESOL, iELPEAK, iCHA_WIDTH, iTOF_DELAY, iPHASE;
  double Frequency;
  double period, phas_ferm;
  double tmin, tmax;
  double dE = 0.0;
  
  char opt1[512], opt2[512], opt3[512], optL[512], optT[512];
  
  int monok_index = 0;
  double vix, viy, viz;
%}

INITIALIZE
%{
  double chopper_const = 252.77;
  double ref_phas = 0;
  double dq = 0, dw = 0;
  
  Ki = 2*PI/lambda;
  vi = K2V*fabs(Ki);
  Ei = VS2E*vi*vi;
  theta = asin(lambda/DM/2);
  A2 = theta*2;
  A1 = atan2(LME*sin(A2),(LME*cos(A2)+LMM))*RAD2DEG;
  A3 = atan2(LME*sin(A2),(LME*cos(A2)-LMM))*RAD2DEG;
  A2 *= RAD2DEG;
  A2cradle = A2;
  RV = 2*LME*sin(theta);
  
  if (A1<0.0) A1=180+A1;
  if (A2<0.0) A2=180+A2;
  if (A3<0.0) A3=180+A3;
  
  if (M1 == 0) A1 = 0; else
    if (M1>=0) A1 = -0.0210199*M1+178.55; else M1 = -(A1-178.55)/0.0210199;
  if (M2 == 0) A2 = 0; else
    if (M2>=0) A2 = -0.0210302*M2+182.558; else M2 = -(A2-182.558)/0.0210302;
  if (M3 == 0) A3 = 0; else
    if (M3>=0) A3 = -0.0206945*M3+187.566; else M3 = -(A3-187.566)/0.0206945;
  
  {
    double el_t_resol = 0.125;
    double phase_offset = 0;
    double el_delay = 44.875;
    double speed, chan_width, dead_time, time_of_flight, trav_time;
    double delta_phase, el_peak_O, delay;
    
    if (TOF_CHA_RESOL<=0) iTOF_CHA_RESOL=128; else iTOF_CHA_RESOL=TOF_CHA_RESOL;
    if (RATIO <= 0) iRATIO = 1; else iRATIO = RATIO;
    if (ELPEAK >= 0 && ELPEAK<=iTOF_CHA_RESOL) iELPEAK = ELPEAK;
      else iELPEAK=ceil(iTOF_CHA_RESOL/2);
    
    speed = 60*K2V/(DM*cos(theta)*(LCE+(LED*pow((1-dE/Ei),-1.5))));
    period = 0.5e6 * 60 * iRATIO/speed;
    chan_width = floor(period/el_t_resol/iTOF_CHA_RESOL)*el_t_resol;
    dead_time = period-(iTOF_CHA_RESOL*chan_width);
    time_of_flight = (0.07+LCC+LCE+LED)/vi*1e6;
    trav_time = LCC/vi*1e6;
    delta_phase = (trav_time/period)*180;
    phas_ferm = ref_phas + delta_phase;
    if (fmod(iRATIO, 2) == 0) phas_ferm *= 2;
    phas_ferm += phase_offset;
    el_peak_O = floor((time_of_flight + el_delay)/chan_width);
    delay = (el_peak_O-iELPEAK) * chan_width;
    if (iELPEAK >= el_peak_O) delay += period;
    if (delay <= 1) delay = 2;
    
    if (PHASE>-180 && PHASE <360) iPHASE=PHASE; else iPHASE=-phas_ferm;
    if (CHA_WIDTH <=0) iCHA_WIDTH=chan_width; else iCHA_WIDTH=CHA_WIDTH;
    if (TOF_DELAY <=0) iTOF_DELAY=delay; else iTOF_DELAY=TOF_DELAY;
    if (SPEED < 0) iSPEED=speed; else iSPEED=SPEED;
    
    Frequency = iSPEED/60;
    
    printf("Instrument Simulation %s (%s)\n", instrument_name, instrument_source);
    printf("  using computed monochromator take-off angles: %g %g %g [deg]\n", A1, A2, A3);
    printf("Wavelength               [AA]  %g\n",  lambda);
    printf("Neutron velocity         [m/s] %g\n",  vi);
    printf("Monochr. Bragg angle     [deg] %g\n",  A2/2);
    printf("Incident Energy          [meV] %g\n",  Ei);
    printf("Focusing Energy transfer[meV] %g\n",  dE);
    printf("Travel time: Supp./Fermi [us]  %g\n",  trav_time);
    printf("Travel time: Supp./Det.  [us]  %g\n",  time_of_flight);
    printf("TOF Delay                [us]  %g\n",  delay);
    printf("TOF Dead Time            [us]  %g\n",  dead_time);
    printf("TOF Period (1 cycle)     [us]  %g\n",  period);
    printf("TOF Channel width        [us]  %g\n",  chan_width);
    printf("CHOP Fermi Phase         [deg] %g\n",  iPHASE);
    printf("CHOP Suppressor Phase    [deg] %g\n",  ref_phas);
    printf("CHOP Fermi Speed         [rpm] %g\n",  iSPEED);
    printf("CHOP Suppressor Speed    [rpm] %g\n",  iSPEED/iRATIO);
    printf("Number of time channels        %g\n",  iTOF_CHA_RESOL);
    printf("Current Elastic Peak Ch.       %g\n",  iELPEAK);
    printf("Elast. peak ch. for 0-delay    %g\n",  el_peak_O);
    
    tmin = time_of_flight*1e-6 - (iCHA_WIDTH*iELPEAK-iTOF_DELAY)*1e-6;
  }
  tmax = tmin+iTOF_CHA_RESOL*iCHA_WIDTH*1e-6;
  printf("Time window:                   min=%g max=%g delay=%g tof-width=%g [ms]\n", 
         tmin*1000, tmax*1000, iTOF_DELAY*1e-3, (tmax-tmin)*1000);
  
  sprintf(opt2, "kxy limits=[0 5] bins=50, energy limits=[%g %g] bins=40, banana, parallel",
    (Ei-20 < 0 ? 0 : Ei-20), Ei+20);
  sprintf(opt1, "angle limits=[0 180] bins=180, energy limits=[%g %g] bins=40, banana, parallel",
    (Ei-20 < 0 ? 0 : Ei-20), Ei+20);
  sprintf(opt3,"user1 limits=[0.5,3.5] bins=9, lambda limits=[%g %g] bins=20, square, per cm2",
    0.97*lambda,1.03*lambda);
  sprintf(optL,"lambda limits=[%g %g] bins=50",lambda-dlambda,lambda+dlambda);
  sprintf(optT,"t slit limits=[%g %g]",tmin, tmax);
%}

TRACE

COMPONENT Origin = Progress_bar(
  profile=1)
AT (0, 0, 0) ABSOLUTE

COMPONENT VCS = Source_gen(
  focus_xw=0.03, focus_yh=0.2, lambda0=lambda, dlambda=dlambda,
  I1=1.24e+13, yheight=0.2, xwidth=0.03, verbose=1,
  T1=216.8, T2=33.9, I2=1.02e+13, T3=16.7, I3=3.0423e+12)
AT (0, 0, 0) RELATIVE Origin

COMPONENT SourceTarget = Arm()
AT (0, 0, 2.55) RELATIVE VCS

COMPONENT Cradle = Arm()
AT (0, 0, 0.15) RELATIVE SourceTarget
SPLIT 10

EXTEND %{
  monok_index=0;
%}

COMPONENT Mono1 = Monochromator_curved(
  reflect="HOPG.rfl", transmit="HOPG.trm",
  zwidth=0.054, yheight=0.029, gap=0.001,
  NH=1, NV=7, r0=1, t0=1, RV=RV, DM=3.355, mosaic=40)
AT (0, 0, -LMM) RELATIVE Cradle
ROTATED (0, A1/2, 0) RELATIVE Cradle

EXTEND %{
  if (SCATTERED) { monok_index=1; }
%}

COMPONENT Mono2 = Monochromator_curved(
  reflect="HOPG.rfl", transmit="HOPG.trm",
  zwidth=0.054, yheight=0.029, gap=0.001,
  NH=1, NV=7, r0=1, t0=1, RV=RV, DM=3.355, mosaic=40)
AT (0, 0, 0) RELATIVE Cradle
ROTATED (0, A2/2, 0) RELATIVE Cradle

EXTEND %{
  if (SCATTERED) { monok_index=2; }
%}

COMPONENT Mono3 = Monochromator_curved(
  reflect="HOPG.rfl", transmit="HOPG.trm",
  zwidth=0.054, yheight=0.029, gap=0.001,
  NH=1, NV=7, r0=1, t0=1, RV=RV, DM=3.355, mosaic=40)
AT (0, 0, +LMM) RELATIVE Cradle
ROTATED (0, A3/2, 0) RELATIVE Cradle

EXTEND %{
  if (SCATTERED) { monok_index=3; }
%}

COMPONENT mono_out = Arm()
AT (0, 0, 0) RELATIVE Cradle
ROTATED (0, A2cradle, 0) RELATIVE Cradle

COMPONENT SuppPos = Arm()
AT (0, 0, LME-LCE-LCC) RELATIVE mono_out

COMPONENT Mon_SuppInL = Monitor_nD(
  xwidth=0.052, yheight=0.098, options=optL)
AT (0, 0, -0.07-0.002) RELATIVE SuppPos

COMPONENT Mon_SuppInT = Monitor_nD(
  xwidth=0.052, yheight=0.098, bins=iTOF_CHA_RESOL, options=optT)
AT (0, 0, -0.07-0.001) RELATIVE SuppPos

EXTEND %{
  double Vi=sqrt(vx*vx+vy*vy+vz*vz);
  double ratio=PI*Frequency/iRATIO/atan(0.052/0.14);
  if (iRATIO && Vi) {
    double Tfermi=atan2(0.052,0.14)/Frequency/PI;
    t = -(0.071/Vi)+(rand01()-0.5)*Tfermi;
    p *= 4*atan2(0.052,0.14)*RAD2DEG/360;
  }
%}

COMPONENT Suppressor = FermiChopper(
  phase=0, radius=0.07, nu=Frequency/iRATIO, nslit=1,
  R0=0, length=0.012, eff=1, xwidth=0.052, verbose=1, yheight=0.098)
AT (0, 0, 0) RELATIVE SuppPos
WHEN (iRATIO > 0)

COMPONENT Mon_SuppOutT = Monitor_nD(
  xwidth=0.052, yheight=0.098, bins=iTOF_CHA_RESOL,
  options="t slit limits=[-700e-6 700e-6]")
AT (0, 0, +0.07+0.001) RELATIVE SuppPos

COMPONENT SlitFC = Slit(
  xwidth=0.0441, yheight=0.0641)
AT (0, 0, LME-LCE-0.041) RELATIVE mono_out

COMPONENT FermiPos = Arm()
AT (0, 0, LME-LCE) RELATIVE mono_out

COMPONENT FermiM = FermiChopper(
  phase=iPHASE, radius=0.04, nu=Frequency, nslit=200.0,
  R0=.99, Qc=(mFC < 1 && mFC ? mFC*0.02176 : 0.02176),
  alpha=2.33, m=mFC, length=0.012, eff=1.0,
  xwidth=0.044, verbose=1, yheight=0.064)
AT (0, 0, 0) RELATIVE FermiPos

COMPONENT Mon_FermiOutdT = Monitor_nD(
  xwidth=0.044, yheight=0.064, bins=iTOF_CHA_RESOL,
  options="t slit limits=[180e-6 365e-6]")
AT (0, 0, +0.06+0.001) RELATIVE FermiPos

COMPONENT MonokMonitor = Monitor_nD(
  user1="monok_index", xwidth=0.2, yheight=0.2,
  options=opt3, username1="Monoch. index")
AT (0, 0, +0.06+0.002) RELATIVE FermiPos

COMPONENT Mon_SampleInT = Monitor_nD(
  xwidth=0.05, yheight=0.05, bins=iTOF_CHA_RESOL,
  options=" t limits=[255e-6 425e-6] parallel, per cm2")
AT (0, 0, LME-.273) RELATIVE mono_out

COMPONENT Mon_SampleInXY = Monitor_nD(
  xwidth=0.06, yheight=0.1,
  options="x y parallel,per cm2 bins=50")
AT (0, 0, 0) RELATIVE Mon_SampleInT

COMPONENT sample_pos = Arm()
AT (0, 0, LME) RELATIVE mono_out

EXTEND %{
  vix=vx;
  viy=vy;
  viz=vz;
%}

COMPONENT Sample = Isotropic_Sqw(
  Sqw_coh=Sqw_coh, Sqw_inc=Sqw_inc,
  radius=radius, thickness=thickness, yheight=0.055, p_interact=0.9)
AT (0, 0, 0) RELATIVE sample_pos
SPLIT 10

EXTEND %{
  if (!SCATTERED) ABSORB;
%}

COMPONENT Out = PSD_monitor_4PI(
  filename="out")
AT (0, 0, 0) RELATIVE sample_pos

COMPONENT M_theta_t_all = Monitor_nD(
  xwidth=2.5, yheight=1, bins=100, options=opt1)
AT (0, 0, 0) RELATIVE sample_pos

COMPONENT Detector_nM = Sqw_monitor(
  qmin=0, qmax=6, Emin=-20, Emax=20, nq=100, nE=100,
  filename="Detector_nM", vix="vix", viy="viy", viz="viz",
  radius=1.3, yheight=1)
AT (0, 0, 0) RELATIVE M_theta_t_all

END
