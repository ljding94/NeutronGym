DEFINE INSTRUMENT TAS_Minimal (
kI = 1.55 
)

DECLARE 
%{
double test_var = 1.5;
%}

INITIALIZE 
%{
// Start of initialize for generated TAS_Minimal
%}

TRACE 
COMPONENT Origin = Progress_bar()
AT (0.0, 0.0, 0.0) ABSOLUTE

COMPONENT Source = Source_gen(
 radius = 0.01, dist = 1,
 focus_xw = 0.01, focus_yh = 0.01,
 I1 = 1, Lmin = 4,
 Lmax = 5)
AT (0.0, 0.0, 0.0) RELATIVE Origin

COMPONENT Monitor = PSD_monitor(
 nx = 10, ny = 10,
 xwidth = 0.01, yheight = 0.01)
AT (0.0, 0.0, 1.0) RELATIVE Origin

FINALLY 
%{
// Start of finally for generated TAS_Minimal
%}

